-- Build a Phone Empire - Guaranteed Working Mod Menu
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Eski menü varsa temizle
if PlayerGui:FindFirstChild("PhoneEmpireModMenu") then
    PlayerGui.PhoneEmpireModMenu:Destroy()
end

-- Ana Ekran GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "PhoneEmpireModMenu"
ScreenGui.Parent = PlayerGui
ScreenGui.ResetOnSpawn = false

-- Aç/Kapat Butonu (Sol üst köşe)
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Parent = ScreenGui
ToggleBtn.Size = UDim2.new(0, 110, 0, 40)
ToggleBtn.Position = UDim2.new(0.02, 0, 0.08, 0)
ToggleBtn.BackgroundColor3 = Color3.fromRGB(40, 120, 220)
ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleBtn.TextSize = 13
ToggleBtn.Font = Enum.Font.GothamBold
ToggleBtn.Text = "MENU AC/KAPAT"

local ToggleCorner = Instance.new("UICorner")
ToggleCorner.CornerRadius = UDim.new(0, 8)
ToggleCorner.Parent = ToggleBtn

-- Ana Panel (Mod Menü Kutusu)
local MainFrame = Instance.new("Frame")
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
MainFrame.Position = UDim2.new(0.5, -125, 0.4, -100)
MainFrame.Size = UDim2.new(0, 250, 0, 180)
MainFrame.Visible = true

local MainCorner = Instance.new("UICorner")
MainCorner.CornerRadius = UDim.new(0, 10)
MainCorner.Parent = MainFrame

-- Başlık
local Title = Instance.new("TextLabel")
Title.Parent = MainFrame
Title.Size = UDim2.new(1, 0, 0, 40)
Title.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
Title.TextColor3 = Color3.fromRGB(255, 255, 255)
Title.TextSize = 15
Title.Font = Enum.Font.GothamBold
Title.Text = "HIZ MODU"

local TitleCorner = Instance.new("UICorner")
TitleCorner.CornerRadius = UDim.new(0, 10)
TitleCorner.Parent = Title

-- Buton Oluşturma Fonksiyonu
local function AddButton(name, posY, callback)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.Size = UDim2.new(0.9, 0, 0, 35)
    btn.Position = UDim2.new(0.05, 0, 0, posY)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 75)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 14
    btn.Font = Enum.Font.GothamSemibold
    btn.Text = name
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(callback)
end

-- Hız Değiştirme Fonksiyonları
AddButton("Normal Hiz (1x)", 55, function()
    pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvent"):FireServer(1)
    end)
    print("Hiz 1x yapildi")
end)

AddButton("Turbo Hiz (8x)", 100, function()
    pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvent"):FireServer(8)
    end)
    print("Hiz 8x yapildi!")
end)

AddButton("Ultra Hiz (16x)", 145, function()
    pcall(function()
        game:GetService("ReplicatedStorage"):WaitForChild("RemoteEvent"):FireServer(16)
    end)
    print("Hiz 16x yapildi!!")
end)

-- Menüyü Aç/Kapat Bağlantısı
ToggleBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

print("Mod Menu Basariyla Yuklendi!")

